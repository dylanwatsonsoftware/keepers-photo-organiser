<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gallery_surface" />
            <stroke android:width="3dp" android:color="@color/gallery_accent_warm" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gallery_surface_elevated" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
