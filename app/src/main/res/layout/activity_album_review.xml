<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAF9F7" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center_vertical" android:paddingHorizontal="18dp">
        <TextView android:id="@+id/album_review_back" android:layout_width="44dp"
            android:layout_height="44dp" android:gravity="center" android:text="‹"
            android:textColor="#3C4043" android:textSize="32sp" android:clickable="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Review albums" android:textColor="#202124"
            android:textSize="26sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/album_review_summary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="20dp"
        android:paddingBottom="14dp" android:textColor="#5F6368" android:textSize="15sp" />
    <TextView android:id="@+id/toggle_reviewed_albums"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:layout_gravity="end" android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp" android:background="@drawable/gallery_filter_chip"
        android:clickable="true" android:focusable="true" android:gravity="center"
        android:paddingHorizontal="14dp" android:text="Show reviewed"
        android:textColor="@color/gallery_filter_text" android:textSize="13sp"
        android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/album_review_run_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="14dp"
        android:background="@drawable/keeper_summary_chip" android:gravity="center"
        android:minHeight="44dp" android:paddingHorizontal="14dp"
        android:textColor="#174EA6" android:textSize="14sp" android:textStyle="bold"
        android:visibility="gone" />
    <LinearLayout android:id="@+id/album_review_recovery_actions"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp"
        android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/resume_album_review"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@drawable/gallery_primary_action"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Resume current change" android:textColor="#FFFFFFFF"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/stop_album_review"
            android:layout_width="96dp" android:layout_height="match_parent"
            android:layout_marginStart="10dp" android:background="@drawable/gallery_filter_chip"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Stop" android:textColor="#3C4043" android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/album_review_setup_people"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp"
        android:background="@drawable/gallery_primary_action" android:clickable="true"
        android:contentDescription="Set up people and Google Photos albums"
        android:focusable="true" android:gravity="center"
        android:text="Set up people and albums" android:textColor="#FFFFFFFF"
        android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
    <ScrollView android:id="@+id/album_review_scroll"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="14dp">
        <LinearLayout android:id="@+id/album_review_items" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingBottom="16dp" />
    </ScrollView>
    <TextView android:id="@+id/confirm_album_review" android:layout_width="match_parent"
        android:layout_height="50dp" android:layout_margin="16dp"
        android:background="@drawable/gallery_primary_action" android:clickable="true"
        android:focusable="true" android:gravity="center"
        android:text="No album changes selected" android:textColor="#FFFFFFFF"
        android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
