<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAF9F7" android:fitsSystemWindows="true" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/people_back" android:layout_width="wrap_content"
            android:layout_height="44dp" android:gravity="center_vertical" android:text="‹  Gallery"
            android:textColor="#5F6368" android:textSize="16sp" android:clickable="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="People to keep" android:textColor="#202124" android:textSize="30sp"
            android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="People you add are learned automatically. Tap a person to edit their name, feature face, linked Google Photos album, or face matches. Nothing is added without review."
            android:textColor="#5F6368" android:textSize="15sp" />
        <TextView android:id="@+id/face_discovery_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:background="@drawable/person_setup_card" android:text="No face observations yet"
            android:textColor="#3C4043" android:textStyle="bold" />
        <LinearLayout android:id="@+id/people_profiles" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:contentDescription="Tracked people" android:orientation="vertical" />
        <TextView android:id="@+id/add_person" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="10dp"
            android:background="@drawable/gallery_primary_action" android:clickable="true"
            android:focusable="true" android:gravity="center"
            android:text="Add another person" android:textColor="#FFFFFFFF"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/people_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:text="People and face choices save automatically."
            android:textColor="#5F6368" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Faces to review"
                android:textColor="#202124" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/toggle_confirmed_faces" android:layout_width="wrap_content"
                android:layout_height="36dp" android:background="@drawable/gallery_filter_chip"
                android:clickable="true" android:focusable="true" android:gravity="center"
                android:paddingHorizontal="14dp" android:text="Show confirmed"
                android:textColor="@color/gallery_filter_text" android:textSize="13sp"
                android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/discovered_faces_summary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="Check each new group and choose who it belongs to."
            android:textColor="#5F6368" android:textSize="14sp" />
        <LinearLayout android:id="@+id/discovered_face_groups" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:orientation="vertical" />
        <TextView android:id="@+id/open_advanced_settings" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="10dp" android:gravity="center"
            android:text="Advanced integration tests" android:textColor="#5F6368"
            android:textSize="14sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</ScrollView>
