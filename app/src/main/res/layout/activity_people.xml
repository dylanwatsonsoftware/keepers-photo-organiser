<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/gallery_background" android:fitsSystemWindows="true" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/people_back" android:layout_width="wrap_content"
            android:layout_height="44dp" android:gravity="center_vertical" android:text="‹  Gallery"
            android:textColor="@color/gallery_text_secondary" android:textSize="16sp" android:clickable="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Settings" android:textColor="@color/gallery_text_primary" android:textSize="30sp"
            android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="People to keep"
            android:textColor="@color/gallery_text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="People you add are learned automatically. Tap a person to edit their name, feature face, linked Google Photos album, or face matches. Nothing is added without review."
            android:textColor="@color/gallery_text_secondary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Add photos"
            android:textColor="@color/gallery_text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Choose photos to assess in Keepers. Imports stay private to this app and never duplicate or change anything in Google Photos."
            android:textColor="@color/gallery_text_secondary" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/settings_import_device" android:layout_width="0dp"
                android:layout_height="42dp" android:layout_weight="1"
                android:background="@drawable/gallery_filter_chip" android:clickable="true"
                android:focusable="true" android:gravity="center" android:text="On-device photos"
                android:textColor="@color/gallery_filter_text" android:textSize="14sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/settings_import_google_photos"
                android:layout_width="0dp" android:layout_height="42dp"
                android:layout_marginStart="8dp" android:layout_weight="1"
                android:background="@drawable/gallery_filter_chip" android:clickable="true"
                android:focusable="true" android:gravity="center" android:text="Google Photos"
                android:textColor="@color/gallery_filter_text" android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Recommendation feedback"
            android:textColor="@color/gallery_text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Export your private ratings and comments to help improve recommendations for everyone."
            android:textColor="@color/gallery_text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/settings_export_feedback"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="10dp" android:background="@drawable/gallery_filter_chip"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Export feedback" android:textColor="@color/gallery_filter_text"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/settings_feedback_sync"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="8dp" android:background="@drawable/gallery_filter_chip"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Automatic sharing: Off" android:textColor="@color/gallery_filter_text"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/settings_feedback_sync_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Off — ratings and comments stay only on this device."
            android:textColor="@color/gallery_text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/settings_restore_hidden"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="8dp" android:background="@drawable/gallery_filter_chip"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Restore hidden photos" android:textColor="@color/gallery_filter_text"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/face_discovery_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:background="@drawable/person_setup_card" android:text="No face observations yet"
            android:textColor="@color/gallery_text_primary" android:textStyle="bold" />
        <LinearLayout android:id="@+id/people_profiles" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:contentDescription="Tracked people" android:orientation="vertical" />
        <TextView android:id="@+id/add_person" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="10dp"
            android:background="@drawable/gallery_primary_action" android:clickable="true"
            android:focusable="true" android:gravity="center"
            android:text="Add another person" android:textColor="@color/gallery_on_primary"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="Other albums"
            android:textColor="@color/gallery_text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Albums that are about a place, event, activity, or anything other than one person."
            android:textColor="@color/gallery_text_secondary" android:textSize="14sp" />
        <LinearLayout android:id="@+id/other_album_profiles"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:contentDescription="Other albums"
            android:orientation="vertical" />
        <TextView android:id="@+id/add_other_album" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="4dp"
            android:background="@drawable/gallery_filter_chip" android:clickable="true"
            android:focusable="true" android:gravity="center" android:text="Add another album"
            android:textColor="@color/gallery_text_primary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/people_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:text="People and face choices save automatically."
            android:textColor="@color/gallery_text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Faces to review"
                android:textColor="@color/gallery_text_primary" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/toggle_confirmed_faces" android:layout_width="wrap_content"
                android:layout_height="36dp" android:background="@drawable/gallery_filter_chip"
                android:clickable="true" android:focusable="true" android:gravity="center"
                android:paddingHorizontal="14dp" android:text="Show confirmed"
                android:textColor="@color/gallery_filter_text" android:textSize="13sp"
                android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/discovered_faces_summary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="Check each new group and choose who it belongs to."
            android:textColor="@color/gallery_text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/load_face_groups" android:layout_width="match_parent"
            android:layout_height="44dp" android:layout_marginTop="10dp"
            android:background="@drawable/gallery_filter_chip" android:clickable="true"
            android:focusable="true" android:gravity="center" android:text="Load face suggestions"
            android:textColor="@color/gallery_filter_text" android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout android:id="@+id/discovered_face_groups" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:orientation="vertical" />
        <TextView android:id="@+id/open_advanced_settings" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="10dp" android:gravity="center"
            android:text="Advanced integration tests" android:textColor="@color/gallery_text_secondary"
            android:textSize="14sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</ScrollView>
