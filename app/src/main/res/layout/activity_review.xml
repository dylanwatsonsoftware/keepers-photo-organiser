<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F7"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Keepers"
            android:textColor="#202124"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/open_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/gallery_icon_button"
            android:contentDescription="Settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            android:tint="#5F6368" />

        <ImageButton
            android:id="@+id/clear_keepers"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gallery_icon_button"
            android:contentDescription="Clear keepers"
            android:padding="11dp"
            android:src="@drawable/ic_clear"
            android:tint="#5F6368" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/photo_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/keeper_count"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/keeper_summary_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:text="No keepers selected yet"
            android:textColor="#174EA6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/suggestion_count"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/suggestion_summary_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:text="Finding best shots…"
            android:textColor="#8A4B00"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/import_photos"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="＋ Device"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/import_google_photos"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.35"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Google Photos"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_origin_all"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="All"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_origin_local"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Local"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_origin_cloud"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Cloud"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/filter_keepers"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="♥  Keepers"
            android:textColor="@color/gallery_filter_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_recommended"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="★  Recommended"
            android:textColor="@color/gallery_filter_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toggle_metadata"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="%  Ratings"
            android:textColor="@color/gallery_filter_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/review_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="Loading recent camera photos…"
        android:textColor="#5F6368"
        android:textSize="16sp" />

    <ScrollView
        android:id="@+id/review_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:clipToPadding="false">

        <GridLayout
            android:id="@+id/photo_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:padding="1dp" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/review_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="12dp"
        android:indeterminateTint="#B06000"
        android:visibility="gone" />
    <TextView
        android:id="@+id/open_album_review"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/gallery_primary_action"
        android:clickable="true"
        android:contentDescription="Review album suggestions"
        android:drawableStart="@drawable/ic_review_albums"
        android:drawablePadding="10dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="Review albums"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
