<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F7"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Keepers"
            android:textColor="#202124"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/open_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/gallery_icon_button"
            android:contentDescription="Settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            android:tint="#5F6368" />

        <ImageButton android:id="@+id/select_photos_to_hide" android:layout_width="44dp"
            android:layout_height="44dp" android:layout_marginStart="4dp"
            android:background="@drawable/gallery_icon_button"
            android:contentDescription="Select media to hide" android:padding="11dp"
            android:src="@drawable/ic_hide" android:tint="#5F6368" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/photo_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/keeper_count"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/keeper_summary_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:text="No keepers selected yet"
            android:textColor="#174EA6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/suggestion_summary_chip"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ProgressBar
                android:id="@+id/suggestion_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:indeterminate="true"
                android:indeterminateTint="#8A4B00"
                android:visibility="gone" />

            <TextView
                android:id="@+id/suggestion_count"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Finding best shots…"
                android:textColor="#8A4B00"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/bulk_hide_actions" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/bulk_hide_status" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:text="Tap photos to select"
            android:textColor="#3C4043" android:textStyle="bold" />
        <TextView android:id="@+id/cancel_hide_photos" android:layout_width="wrap_content"
            android:layout_height="40dp" android:background="@drawable/gallery_filter_chip"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:paddingHorizontal="14dp" android:text="Cancel" android:textColor="#3C4043"
            android:textStyle="bold" />
        <TextView android:id="@+id/confirm_hide_photos" android:layout_width="wrap_content"
            android:layout_height="40dp" android:layout_marginStart="8dp"
            android:background="@drawable/gallery_primary_action" android:clickable="true"
            android:focusable="true" android:gravity="center" android:paddingHorizontal="14dp"
            android:text="Hide selected" android:textColor="#FFFFFF" android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/review_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/filter_origin_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="All sources"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_keepers"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="♥  Keepers"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_include_keepers"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Include Keepers"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_recommended"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="★  Suggested"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_hidden"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Hidden"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_origin_local"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="On device"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_origin_cloud"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Cloud"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_media_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="All media"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_photos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Photos"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_videos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Videos"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toggle_metadata"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="%  Ratings"
            android:textColor="@color/gallery_filter_text"
            android:textSize="13sp"
            android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/open_quick_review"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/gallery_primary_action"
            android:clickable="true"
            android:contentDescription="Start quick review"
            android:focusable="true">

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center_vertical|start"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_swipe_cards" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Quick review"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/review_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="Loading recent camera photos…"
        android:textColor="#5F6368"
        android:textSize="16sp" />

    <ScrollView
        android:id="@+id/review_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:clipToPadding="false">

        <GridLayout
            android:id="@+id/photo_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:padding="1dp" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/review_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="12dp"
        android:indeterminateTint="#B06000"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/open_album_review"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/gallery_primary_action"
        android:clickable="true"
        android:contentDescription="Review and add Keepers to Google Photos albums"
        android:focusable="true">

        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_vertical|start"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_review_albums" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Add to albums"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
