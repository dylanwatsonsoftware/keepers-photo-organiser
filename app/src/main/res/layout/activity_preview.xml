<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/preview_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/preview_adjacent_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/preview_adjacent_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/preview_current_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/preview_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/photo_icon_button"
        android:contentDescription="Close photo"
        android:elevation="3dp"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:tint="#FFFFFF" />

    <TextView
        android:id="@+id/quick_review_mode_badge"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/preview_recommendation_chip"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:text="Quick review · Swipe cards"
        android:textColor="#FFD38A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/quick_review_keep_indicator"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/quick_review_keep_indicator"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="✓  KEEP"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/quick_review_pass_indicator"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/quick_review_pass_indicator"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="✕  PASS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/preview_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/preview_controls_gradient"
        android:elevation="2dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="64dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <HorizontalScrollView
            android:id="@+id/preview_stack_carousel"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/preview_stack_thumbnails"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/preview_recommendation_slot"
            android:layout_width="match_parent"
            android:layout_height="36dp">
            <TextView
                android:id="@+id/preview_recommendation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/preview_recommendation_chip"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="#FFD38A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="invisible" />
        </FrameLayout>

        <TextView
            android:id="@+id/preview_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Swipe to browse  ·  Pinch to zoom  ·  Up for details  ·  Down to close"
            android:textColor="#BFFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/preview_keeper"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/preview_keeper_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="♡ Mark as keeper"
            android:textColor="#202124"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_start_quick_review"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/gallery_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Start quick review"
            android:textColor="@color/gallery_filter_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/preview_analysis_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="72dp"
        android:background="@drawable/preview_analysis_sheet"
        android:elevation="5dp"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/preview_analysis_navigation_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:text="Swipe left or right for the next photo’s details"
                android:textColor="#5F6368"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/preview_analysis_faces_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="People in this photo"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/preview_analysis_faces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:orientation="horizontal"
                android:useDefaultMargins="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/preview_metadata_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/keeper_summary_chip"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Photo details"
                    android:textColor="#202124"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_metadata_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="#3C4043"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/preview_metadata_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="#3C4043"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/preview_metadata_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="#5F6368"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/preview_metadata_technical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="#5F6368"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preview_saved_albums_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/keeper_summary_chip"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Saved to albums"
                    android:textColor="#202124"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_saved_albums"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#5F6368"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_analysis_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#202124"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preview_analysis_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#5F6368"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/preview_feedback"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/gallery_primary_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Help improve recommendations"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
