<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keepers"
            android:textColor="#202124"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Google Photos integration test"
            android:textColor="#5F6368"
            android:textSize="17sp" />

        <Button
            android:id="@+id/open_review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Review recent photos" />

        <Button
            android:id="@+id/open_people"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="People and album setup" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Google Photos favourite sync"
            android:textColor="#202124"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/check_media_favorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Check local favourite state" />

        <TextView
            android:id="@+id/favorite_diagnostic_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F3F4"
            android:padding="16dp"
            android:text="Not checked yet."
            android:textColor="#202124"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Favourite one known local Pixel photo in Google Photos, return here, then check again. A changed count means Keepers can read the sync state."
            android:textColor="#5F6368" />

        <TextView
            android:id="@+id/selection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#F1F3F4"
            android:padding="16dp"
            android:text="No photos selected"
            android:textColor="#202124"
            android:textSize="16sp" />

        <Button
            android:id="@+id/open_accessibility_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Enable Keepers Accessibility service" />

        <Button
            android:id="@+id/arm_accessibility_favourite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Arm one-shot Favourite (2 minutes)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="After arming, Keepers opens Google Photos. Manually open one expendable test photo; Keepers will tap an exact Favourite control once, then disarm."
            android:textColor="#B3261E" />

        <EditText
            android:id="@+id/album_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Exact existing album name"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/arm_accessibility_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arm one-shot Add to album" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="After arming, manually open one test photo. Keepers clicks Add to album, then only the exact album name above, and disarms."
            android:textColor="#B3261E" />

        <Button
            android:id="@+id/choose_photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Load latest 5 local camera photos" />

        <Button
            android:id="@+id/open_existing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="1. Open first existing photo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm that Google Photos opens the original item and exposes its normal Favourite and Add to album controls."
            android:textColor="#5F6368" />

        <Button
            android:id="@+id/request_favourite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="2. Request Android favourite" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android will show a system confirmation. Afterwards, check whether Google Photos’ cloud Favourite state changed."
            android:textColor="#5F6368" />

        <Button
            android:id="@+id/share_experiment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="3. Batch album experiment — DUPLICATE RISK" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This invokes Google Photos’ share/import surface. Stop if it offers only Upload. If you continue, verify that no duplicate cloud items are created."
            android:textColor="#B3261E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pass criteria\n\n• Existing backed-up item opens reliably\n• Favourite state syncs to photos.google.com\n• Several originals can be added to an existing album\n• No duplicate uploads are created\n• Results still exist after local copies are removed"
            android:textColor="#202124"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
