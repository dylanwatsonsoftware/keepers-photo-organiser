<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAF9F7" android:fitsSystemWindows="true" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/person_detail_back" android:layout_width="wrap_content"
            android:layout_height="44dp" android:gravity="center_vertical" android:text="‹  People"
            android:textColor="#5F6368" android:textSize="16sp" android:clickable="true" />
        <ImageView android:id="@+id/person_detail_feature" android:layout_width="112dp"
            android:layout_height="112dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp" android:background="@drawable/preview_face_crop"
            android:clipToOutline="true" android:contentDescription="Feature face"
            android:scaleType="centerCrop" />
        <TextView android:id="@+id/person_detail_name_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Name"
            android:textColor="#5F6368" android:textSize="13sp" android:textStyle="bold" />
        <EditText android:id="@+id/person_detail_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:hint="Enter a name" android:inputType="textCapWords" android:textSize="22sp" />
        <TextView android:id="@+id/person_detail_album_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Google Photos album"
            android:textColor="#5F6368" android:textSize="13sp" android:textStyle="bold" />
        <EditText android:id="@+id/person_detail_album" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:hint="Exact Google Photos album name" android:inputType="textCapWords" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Changes save automatically. Album actions still require review and confirmation."
            android:textColor="#5F6368" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/person_detail_faces_title" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Confirmed faces" android:textColor="#202124"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/person_detail_select_faces"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:background="@drawable/gallery_filter_chip" android:clickable="true"
                android:focusable="true" android:gravity="center" android:paddingHorizontal="14dp"
                android:text="Select faces" android:textColor="@color/gallery_filter_text"
                android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/person_detail_faces_summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="#5F6368" android:textSize="14sp" />
        <LinearLayout android:id="@+id/person_detail_bulk_actions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical"
            android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/person_detail_bulk_status" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="0 faces selected" android:textColor="#3C4043"
                android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/person_detail_cancel_selection"
                android:layout_width="wrap_content" android:layout_height="38dp"
                android:background="@drawable/gallery_filter_chip" android:clickable="true"
                android:focusable="true" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="Cancel" android:textColor="@color/gallery_filter_text"
                android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/person_detail_remove_selected"
                android:layout_width="wrap_content" android:layout_height="38dp"
                android:layout_marginStart="8dp" android:background="@drawable/person_remove_action"
                android:clickable="true" android:focusable="true" android:gravity="center"
                android:paddingHorizontal="12dp" android:text="Remove selected"
                android:textColor="#B3261E" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <GridLayout android:id="@+id/person_detail_faces" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:alignmentMode="alignMargins" android:columnCount="2"
            android:orientation="horizontal"
            android:useDefaultMargins="false" />
        <TextView android:id="@+id/person_detail_show_more_faces"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginBottom="24dp" android:background="@drawable/gallery_filter_chip"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Show more" android:textColor="@color/gallery_filter_text"
            android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
